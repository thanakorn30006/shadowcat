# ==============================================================================
# SHADOW CAT — Environment & OpSec Configuration
# ==============================================================================
# All cyber operations tools run 100% offline without API keys.
# AI Assistants (Optional - Leave blank to enforce complete offline mode):
GEMINI_API_KEY=
PRIMARY_MODEL=gemini-2.5-flash

# PSU AI / OpenAI-compatible endpoint (Optional):
PSU_AI_API_KEY=
PSU_AI_BASE_URL=https://ai.psu.blue/v1
PSU_AI_MODEL=PSU-LLM/psu-gemma
PREFERRED_AI_PROVIDER=gemini

# Operational Security / Air-Gapped Mode:
# Set to 1 to block all outbound public lookups (FactorDB, CrackStation, etc.)
AIR_GAPPED=0
SHADOWCAT_OFFLINE=0
